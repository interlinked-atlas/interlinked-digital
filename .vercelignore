# Exclude home directory folders not part of the Next.js project.
# Anchored with a leading slash on purpose — without it, a gitignore-style
# pattern matches a directory of that name at ANY depth, which is exactly
# what broke downloads: unanchored "Downloads/" also matched this project's
# own public/downloads/ and app/downloads/ folders and silently dropped
# everything inside them from every deployment, regardless of filename or
# extension — the real cause of ATLAS.dmg (and even a fresh test .txt file)
# 404ing in production, not .vercelignore's *.dmg rule as first suspected.
/Library/
/Desktop/
/Applications/
/Movies/
/Music/
/Pictures/
/Documents/
/Downloads/

# Dot dirs
.installbuilder/
.anydesk/
.cache/
.cargo/
.config/
.cups/
.cursor/
.firebase/
.idlerc/
.local/
.matplotlib/
.ngrok/
.npm/
.nvm/
.nx/
.pyenv/
.qt/
.rustup/
.ssh/
.swiftpm/
.thumbnails/
.videostream/
.vnc/
.vscode/
.zsh_sessions/
.claude/
.claude.json
.claude.json.backup
.mcp.json

# Build / dev
.next/
node_modules/
.env*
.vercel/
*.log
*.dmg
*.zip

# Mac noise
.DS_Store
/Library/Saved Application State/
